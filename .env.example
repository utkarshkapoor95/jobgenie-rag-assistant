# Required: Get free at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key

# Required: Get free at https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key

# Pinecone index name (created automatically if it does not exist)
PINECONE_INDEX_NAME=jobgenie-index

# Optional: Only needed for HuggingFace Spaces deployment
HF_TOKEN=your_huggingface_token

# Required for "Find Matching Jobs" feature. Get free (no credit card) at
# https://app.openwebninja.com/signup, then subscribe to the Free plan at
# https://app.openwebninja.com/api/jsearch
JSEARCH_API_KEY=your_jsearch_api_key
